DATABASE_URL=sqlite:///./dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee
# INSTANCE_UNIX_SOCKET=YOUR_PROJECT_ID:us-central1:coffee-db

# Mandatory JWT secret key: must be at least 8 characters and not use default/insecure keys
JWT_SECRET=replace-with-a-strong-random-secret
